+    private static (
+        CandidateGenerationResult Generated,
+        VehicleCandidateSet Set,
+        InsertionCandidate NoOp,
+        CommitmentMechanismContext Context) NoOpRejectedWhileAnInsertionSurvives()
+    {
+        var fixture = CreateState(seed: 3);
