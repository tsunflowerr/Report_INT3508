+            new RouteStop(
+                new StopId("before-drop"),
+                ApplicationTestData.NodeOne,
+                RouteStopKind.Waypoint,
+                null,
+                new Duration(300)));
+        return RoutePlan.Create(
+            new PlanVersion(route.Version.Value + 1),
+            route.ExecutedStopCount,
+            route.FrozenPrefix,
